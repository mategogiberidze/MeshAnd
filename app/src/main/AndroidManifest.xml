<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Meshtastic SDK 0.1.0 declares minSdk 26 but uses no API above 24 in its bytecode. -->
    <uses-sdk tools:overrideLibrary="org.meshtastic.sdk, org.meshtastic.sdk.transport.ble" />

    <!-- Android 7–11 (API 24–30): legacy Bluetooth permissions + location for BLE scanning. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Android 12+ (API 31+): scan without deriving location, and connect. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Foreground service keeping the radio link alive while OsmAnd is in front. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 13+: needed to show the connection notification (the service runs without it). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only for the optional "new version available" check against GitHub Releases. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Android 11+ package visibility: find and bind OsmAnd's AIDL V2 service. -->
    <queries>
        <package android:name="net.osmand" />
        <package android:name="net.osmand.plus" />
        <package android:name="net.osmand.dev" />
        <package android:name="net.osmand.huawei" />
        <intent>
            <action android:name="net.osmand.aidl.OsmandAidlServiceV2" />
        </intent>
    </queries>

    <application
        android:name=".MeshAndApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeshAnd">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Team list, launched by OsmAnd's map widget (explicit intent) or side-menu item
             (meshand://team). Own task so Back returns to OsmAnd. -->
        <activity
            android:name=".ui.team.TeamActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="team"
                    android:scheme="meshand" />
            </intent-filter>
        </activity>

        <!-- Share target: OsmAnd → tap a place → Share → "MeshAnd pin". -->
        <activity
            android:name=".ui.pin.SharePinActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_pin_label"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Pin images for OsmAnd's map (generated, read-only). -->
        <provider
            android:name=".data.osmand.PinIconProvider"
            android:authorities="${applicationId}.pinicons"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <service
            android:name=".service.MeshConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
